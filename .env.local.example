NEXT_PUBLIC_SUPABASE_URL=PASTE_YOUR_SUPABASE_URL_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_YOUR_SUPABASE_ANON_KEY_HERE

# Server-only. Required only for Darik admins to open private activation receipts.
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVER_ONLY_SERVICE_ROLE_KEY_HERE

# Existing Google Places / Maps server key used by the signup location search.
GOOGLE_PLACES_API_KEY=PASTE_GOOGLE_PLACES_SERVER_KEY_HERE

# Darik's own CliQ details shown to stores paying for activation.
NEXT_PUBLIC_DARIK_CLIQ_NAME=PASTE_DARIK_CLIQ_ACCOUNT_NAME_HERE
NEXT_PUBLIC_DARIK_CLIQ_ALIAS=PASTE_DARIK_CLIQ_ALIAS_OR_MOBILE_HERE
